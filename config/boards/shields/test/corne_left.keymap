#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                    bindings = <
                        &kp GRAVE  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5               
                        &kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T               
                        &kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G               
                        &kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &kp B               
                                   &kp LALT  &kp LGUI  &kp SPACE  &kp LALT   &kp LGUI            
                    >;
                };
                lower_layer {
                    bindings = <
                        &trans    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4          
                        &trans    &trans         &trans         &trans         &trans         &trans               
                        &trans    &trans         &trans         &kp LPAR       &kp RPAR       &trans              
                        &trans    &trans         &trans         &trans         &trans         &trans               
                                  &trans         &trans         &trans         &trans         &trans  
                    >;
                };
        };
};